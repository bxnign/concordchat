  },
  "homepage": "https://github.com/bxnign/concordchat#readme",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.1",
